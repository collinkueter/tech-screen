# Application Configuration
PROJECT_NAME="Quorus Chorus API"
SERVER_NAME=io.quorus.chorus
SERVER_HOST=http://localhost:4000
BACKEND_CORS_ORIGINS='["http://localhost", "http://localhost:4000", "http://localhost:3000"]'
USERS_OPEN_REGISTRATION=True

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quorus_chorus

# Security
FIRST_SUPERUSER=admin@quorus.io
FIRST_SUPERUSER_PASSWORD=changethis

# External Services
EXTERNAL_API_URL=http://external-api:4001
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRY_COUNT=3

# Development Settings
DEBUG=False  # Set to True for debugging with VS Code

# Feature Flags
ENABLE_CACHING=True
ENABLE_WEBHOOKS=False
ENABLE_BULK_OPERATIONS=True
